rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validSession(id) {
      let d = request.resource.data;
      return d.id == id
        && d.venue is string && d.venue.size() > 0 && d.venue.size() <= 120
        && d.currency in ['JPY','USD','EUR','GBP','HKD','KRW','PHP','VND','THB','TWD']
        && d.game in ['ライブ','オンライン']
        && d.startedAt is string && d.startedAt.size() <= 40
        && d.buyIn is int && d.buyIn >= 0
        && d.rebuy is int && d.rebuy >= 0
        && d.cashOut is int && d.cashOut >= 0
        && d.tips is int && d.tips >= 0
        && (!('format' in d) || d.format in ['cash','tournament'])
        && (!('entrants' in d) || (d.entrants is int && d.entrants > 0 && d.entrants <= 1000000))
        && (!('prizePool' in d) || (d.prizePool is int && d.prizePool >= 0))
        && (!('tripId' in d) || (d.tripId is string && d.tripId.size() <= 120))
        && d.note is string && d.note.size() <= 4000;
    }
    function validPlayer(id) {
      let d = request.resource.data;
      return d.id == id
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.venue is string && d.venue.size() <= 120
        && d.tags is list && d.tags.size() <= 20
        && d.note is string && d.note.size() <= 4000;
    }
    function validTrip(id) {
      let d = request.resource.data;
      return d.id == id
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.destination is string && d.destination.size() <= 120
        && d.startDate is string && d.startDate.size() == 10
        && d.endDate is string && d.endDate.size() == 10
        && d.startDate <= d.endDate
        && d.expenses is list && d.expenses.size() <= 500
        && d.note is string && d.note.size() <= 4000;
    }
    match /users/{uid}/sessions/{id} {
      allow get, list, delete: if owner(uid);
      allow create, update: if owner(uid) && validSession(id);
    }
    match /users/{uid}/players/{id} {
      allow get, list, delete: if owner(uid);
      allow create, update: if owner(uid) && validPlayer(id);
    }
    match /users/{uid}/trips/{id} {
      allow get, list, delete: if owner(uid);
      allow create, update: if owner(uid) && validTrip(id);
    }
  }
}
